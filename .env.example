# ==============================================================================
# FactoryPulse AI — Environment Configuration
# Smart Factory Production Bottleneck Prediction
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development               # development | testing | production
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------------------
# 2. MQTT BROKER CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'hivemq' for cloud broker or 'local' for local Mosquitto / fallback broker
MQTT_MODE=local

# Local Broker Settings
MQTT_LOCAL_HOST=127.0.0.1
MQTT_LOCAL_PORT=1883
MQTT_LOCAL_KEEPALIVE=60

# HiveMQ Cloud Broker Settings (Layer 2 & beyond)
# Obtain these free from: https://console.hivemq.cloud/
MQTT_HIVEMQ_HOST=your-cluster-id.s1.eu.hivemq.cloud
MQTT_HIVEMQ_PORT=8883
MQTT_HIVEMQ_USERNAME=factory_admin
MQTT_HIVEMQ_PASSWORD=SecurePassword123!
MQTT_HIVEMQ_USE_TLS=true

# MQTT Topic Prefix & Definitions
MQTT_CLIENT_ID_PREFIX=factorypulse_
MQTT_TOPIC_STATION1=factory/station01/telemetry
MQTT_TOPIC_STATION2=factory/station02/telemetry
MQTT_TOPIC_STATION3=factory/station03/telemetry
MQTT_TOPIC_PROCESSED=factory/processed/telemetry
MQTT_TOPIC_PREDICTIONS=factory/predictions
MQTT_TOPIC_ALERTS=factory/alerts
MQTT_TOPIC_MOTOR_COMMANDS=factory/devices/motor01/commands
MQTT_TOPIC_MOTOR_STATUS=factory/devices/motor01/status

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SQLite Layer 3)
# ------------------------------------------------------------------------------
DATABASE_PATH=data/database/factorypulse.db
DATABASE_WAL_MODE=true
DATABASE_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# 4. SIMULATION ENGINE SETTINGS
# ------------------------------------------------------------------------------
SIMULATION_INTERVAL_SEC=1.0           # Telemetry publication interval (seconds)
SIMULATION_TIME_SCALE=1.0             # Acceleration multiplier (1.0 = real-time, 2.0 = 2x speed)
DEFAULT_SCENARIO=scenario_a           # scenario_a | scenario_b | scenario_c | scenario_d | scenario_e | scenario_f
STATION2_MODE=simulated               # simulated | hardware (ESP32)

# Production Baseline Parameters
DEMAND_RATE_UNITS_PER_MIN=15.0        # Target factory incoming production demand
MAX_QUEUE_CAPACITY=50                 # Maximum capacity per workstation queue buffer

# Station 1 - Cutting (Simulated)
STATION1_BASE_RPM=1800.0
STATION1_CYCLE_TIME_SEC=3.5
STATION1_CAPACITY_PER_MIN=17.0

# Station 2 - Drilling / Machining (ESP32 or Simulated)
STATION2_BASE_RPM=1500.0
STATION2_CYCLE_TIME_SEC=4.0
STATION2_CAPACITY_PER_MIN=15.0

# Station 3 - Packaging (Simulated)
STATION3_BASE_RPM=1200.0
STATION3_CYCLE_TIME_SEC=3.0
STATION3_CAPACITY_PER_MIN=20.0

# ------------------------------------------------------------------------------
# 5. ALERT ENGINE THRESHOLDS (Node-RED Layer 4)
# ------------------------------------------------------------------------------
ALERT_RPM_CRITICAL_RATIO=0.40         # Alert if RPM falls below 40% of nominal
ALERT_RPM_WARNING_RATIO=0.70          # Alert if RPM falls below 70% of nominal
ALERT_QUEUE_WARNING_THRESHOLD=15      # Warning when queue exceeds 15 units
ALERT_QUEUE_CRITICAL_THRESHOLD=30     # Critical when queue exceeds 30 units
ALERT_HYSTERESIS_COUNT=3              # Number of consecutive readings to trigger
ALERT_COOLDOWN_SECONDS=20             # Cooldown between repeated identical alerts

# ------------------------------------------------------------------------------
# 6. MACHINE LEARNING CONFIGURATION (Layer 5)
# ------------------------------------------------------------------------------
ML_MODEL_PATH=ml/models/bottleneck_rf_model.joblib
ML_METADATA_PATH=ml/models/model_metadata.json
ML_PREDICTION_HORIZON_SEC=60          # Predict bottleneck 60 seconds into future
ML_ROLLING_WINDOW_SIZE=10             # Feature extraction window size

# ------------------------------------------------------------------------------
# 7. SECURITY & AUTHENTICATION (Layer 5)
# ------------------------------------------------------------------------------
# First-run admin setup (Never store production passwords in plain text in production)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=FactoryAdmin2026!
OPERATOR_USERNAME=operator
OPERATOR_INITIAL_PASSWORD=FactoryOp2026!
SESSION_SECRET_KEY=generate_a_random_32_byte_secret_here_for_sessions_2026!
JWT_EXPIRATION_HOURS=12

# ------------------------------------------------------------------------------
# 8. HARDWARE / ESP32 CONFIGURATION (Layer 6)
# ------------------------------------------------------------------------------
ESP32_PULSES_PER_REV=20               # IR sensor optical encoder disk slots
ESP32_MOTOR_MIN_RPM=100.0
ESP32_MOTOR_MAX_RPM=2000.0
ESP32_PWM_FREQUENCY=20000
ESP32_PWM_RESOLUTION_BITS=8

