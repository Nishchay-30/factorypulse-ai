    {
        "id": "fp_rules",
        "type": "function",
        "z": "fp_main",
        "name": "Bottleneck alerts",
        "func": "\nconst d = msg.payload;\nif (!d || typeof d !== 'object') return null;\n\nconst id = d.station_id;\nconst base = {\n  station01: 1800,\n  station02: 1500,\n  station03: 1200\n}[id];\n\nif (!base) return null;\n\nconst rpm = Number(d.rpm);\nconst queue = Number(d.queue_length);\n\nif (!Number.isFinite(rpm) ||\n    !Number.isFinite(queue)) return null;\n\nlet state = context.get(id) || {count:0, last:0};\nconst abnormal = rpm < base*0.7 || queue >= 15;\n\nstate.count = abnormal ? state.count+1 : 0;\nconst now = Date.now();\n\nif (state.count >= 3 &&\n    (state.last === 0 || now-state.last >= 20000)) {\n  state.last = now;\n  msg.topic = \"factory/alerts\";\n  msg.payload = JSON.stringify({\n    station_id: id,\n    severity: \"WARNING\",\n    message: \"Potential production bottleneck\",\n    rpm: rpm,\n    queue_length: queue,\n    timestamp: new Date(now).toISOString()\n  });\n  context.set(id,state);\n  return msg;\n}\n\ncontext.set(id,state);\nreturn null;\n",
        "outputs": 1,
        "x": 580,
        "y": 140,
        "wires": [
            [
                "fp_debug",
                "381e033b4449f55b"
            ]
        ]
    },
