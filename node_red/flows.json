    {
        "id": "381e033b4449f55b",
        "type": "function",
        "z": "fp_main",
        "name": "Format API Alert",
        "func": "\nlet data = msg.payload;\n\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch (err) {\n        node.error(\"Invalid alert JSON\", msg);\n        return null;\n    }\n}\n\nconst baseRPM = {\n    station01: 1800,\n    station02: 1500,\n    station03: 1200\n};\n\nif (!data || !baseRPM[data.station_id] ||\n    !Number.isFinite(Number(data.rpm))) {\n    node.warn(\"Invalid station or RPM\");\n    return null;\n}\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    station_id: data.station_id,\n    severity: data.severity || \"WARNING\",\n    alert_code: \"NODERED_BOTTLENECK\",\n    message: data.message || \"Production bottleneck detected\",\n    measured_value: Number(data.rpm),\n    threshold_value: baseRPM[data.station_id] * 0.7\n};\n\ndelete msg.topic;\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 40,
        "wires": [
